{
  "name": "menuqr-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3003",
    "build": "node -e \"if(process.platform!=='win32'){try{require('child_process').execSync('chmod -R 755 . 2>/dev/null')}catch(e){}}\" && prisma generate && next build",
    "postinstall": "prisma generate",
    "start": "next start -p 3003",
    "lint": "eslint",
    "db:sync": "node scripts/sync-schema.mjs",
    "db:generate": "node scripts/sync-schema.mjs && prisma generate"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "next": "16.2.12",
    "qrcode": "^1.5.4",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "prisma": "^6.19.3",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
